# Pinned DeProof node agent used by scripts/build-node-agent.sh and scripts/node-agent-it.sh.
DEPROOF_REPO=https://github.com/CodesbyFebin/DeProof--EdgeORE.git
DEPROOF_REV=7431f0896f4fb5409970f3aa3f64c42f6f877757
# node-agent/go.mod requires this toolchain; GOTOOLCHAIN fetches it if the local Go is older.
GO_TOOLCHAIN=go1.26.4
