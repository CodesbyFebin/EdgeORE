              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#unnecessaryfilter",
              "id": "detekt.style.UnnecessaryFilter",
              "name": "UnnecessaryFilter",
              "shortDescription": {
                "text": "`filter()` with other collection operations may be simplified."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#unnecessarylet",
              "id": "detekt.style.UnnecessaryLet",
              "name": "UnnecessaryLet",
              "shortDescription": {
                "text": "The `let` usage is unnecessary."
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#maybeconst",
              "id": "detekt.style.MayBeConst",
              "name": "MayBeConst",
              "shortDescription": {
