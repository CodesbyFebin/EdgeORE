              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#forbiddenvoid",
              "id": "detekt.style.ForbiddenVoid",
              "name": "ForbiddenVoid",
              "shortDescription": {
                "text": "`Unit` should be used instead of `Void`."
              }
            },
