              "defaultConfiguration": {
                "level": "error"
              },
              "helpUri": "https://detekt.dev/style.html#userequire",
              "id": "detekt.style.UseRequire",
              "name": "UseRequire",
              "shortDescription": {
                "text": "Use require() instead of throwing an IllegalArgumentException."
              }
            },
